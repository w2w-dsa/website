---
export interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

<nav class="pt-4">
  <ul class="space-y-6">
    {links.map((link) => (
      <li>
        <a 
          href={link.href} 
          class="text-2xl md:text-3xl font-black text-w2w-muted hover:text-w2w-red transition-colors block"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
