---
import A from './A.astro';
export interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

<nav class="pt-4">
  <ul class="space-y-6">
    {links.map((link) => (
      <li class="text-2xl md:text-3xl block">
        <A
          href={link.href} 
        >
          {link.label}
        </A>
      </li>
    ))}
  </ul>
</nav>
