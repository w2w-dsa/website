---
export interface Props {
  name: string;
  label: string;
  required?: boolean;
  options: { value: string; label: string }[];
}

const { name, label, required = false, options } = Astro.props;
---

<div class="space-y-4 pt-4 border-t border-w2w-muted/20">
  <label class="block text-lg font-black text-w2w-muted">
    {label} {required && <span class="text-w2w-red">*</span>}
  </label>
  
  <div class="space-y-3">
    {options.map((option) => (
      <label class="flex items-start gap-3 cursor-pointer group">
        <input 
          type="checkbox" 
          name={name} 
          value={option.value} 
          class="mt-1 w-5 h-5 accent-w2w-red border-2 border-w2w-muted/30 rounded-none cursor-pointer" 
        />
        <span class="text-w2w-muted group-hover:text-w2w-red transition-colors leading-relaxed">
          {option.label}
        </span>
      </label>
    ))}
  </div>
</div>
