---
import A from './A.astro';
import Button from './Button.astro';

export interface Props {
  title: string;
  texture: string;
  href?: string;
  originalurl?: string;
  originaltitle?: string;
}

const { originalurl, originaltitle, title, texture, href } = Astro.props;

let buttonTitle = "Read Full Resolution";

if (originalurl) {
  buttonTitle = "Read Amendment";
}

---

<section class:list={["px-6 md:px-16 py-16 bg-w2w-dark bg-cover bg-center relative overflow-hidden", texture]}>
  <div class="absolute inset-0 bg-w2w-dark/80"></div>

  <div class="max-w-4xl space-y-6 relative z-10">
    
    <div class="flex items-start gap-4 pl-6 md:pl-14">
      <img src="/svgs/sphere1.svg" alt="" class="w-8 h-8 md:w-10 md:h-10 flex-shrink-0 mt-1" />
      <h3 class="text-2xl md:text-3xl font-black leading-tight text-w2w-muted w-full">
        {title}
      </h3>
    </div>

      {originalurl && originaltitle && (
    <div class="flex items-start gap-4 pl-6 md:pl-14">
      <h4 class="text-xl md:text-2xl font-black leading-tight text-w2w-muted">
        Amends “<A href={originalurl}>{originaltitle}</A>”
      </h4>
    </div>
      )}

    <div class="text-lg md:text-xl leading-relaxed font-regular text-w2w-muted pl-6 md:pl-14">
      <slot />
    </div>

    {href && (
      <div class="pl-12 md:pl-14">
        <Button href={href}>{buttonTitle}</Button>
      </div>
    )}

  </div>
</section>

