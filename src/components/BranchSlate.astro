---
export interface Props {
  name: string;
  texture: string;
  rawList: string;
}
const { name, rawList, texture } = Astro.props;

const rawCandidates = rawList.split('\n').map(n => n.trim()).filter(n => n !== '');

let hasDelegates = false;

const candidates = rawCandidates.map(name => {
  if (name.includes('*')) {
    hasDelegates = true;
    return { name: name.replace(/\*/g, '').trim(), isDelegate: true };
  }
  return { name, isDelegate: false };
});
---

<section class:list={["px-6 md:px-16 py-16 bg-w2w-dark bg-cover bg-center relative overflow-hidden", texture]}>
  <div class="absolute inset-0 bg-w2w-dark/80"></div>

  <div class="max-w-4xl space-y-6 relative z-10">
    
      <div class="mb-8">
    <h3 class="text-3xl md:text-4xl font-black text-w2w-muted uppercase tracking-tight">
      {name}
    </h3>
    <div class="w-24 h-1.5 bg-gradient-to-r from-w2w-red to-w2w-coral mt-3"></div>
  </div>

  <ul class="columns-2 sm:columns-3 xl:columns-4 gap-x-8 gap-y-3 list-none p-0 m-0">
    {candidates.map((candidate) => (
      <li class="break-inside-avoid mb-4 text-xl font-bold text-w2w-muted flex items-center gap-2">
        <span>{candidate.name}</span>
        {candidate.isDelegate && (
          <svg class="w-4 h-4 text-w2w-red flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-label="FEC Delegate">
            <circle cx="12" cy="12" r="10" />
          </svg>
        )}
      </li>
    ))}
  </ul>

  {hasDelegates && (
    <div class="mt-8 flex items-center gap-3 text-w2w-muted">
      <svg class="w-4 h-4 text-w2w-red flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
      </svg>
      <span class="text-sm font-regular italic">Stop the Demolition of Fulton & Elliott-Chelsea Organizers</span>
    </div>
  )}

  </div>
</section>


