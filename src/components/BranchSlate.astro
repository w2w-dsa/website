---
export interface Props {
  id: string;
  name: string;
  texture: string;
  rawList: string;
}
const { id, name, rawList, texture } = Astro.props;

const rawCandidates = rawList.split('\n').map(n => n.trim()).filter(n => n !== '');

let hasDelegates = false;

const candidates = rawCandidates.map(name => {
  if (name.includes('*')) {
    hasDelegates = true;
    return { name: name.replace(/\*/g, '').trim(), isDelegate: true };
  }
  return { name, isDelegate: false };
});

// The share button rides along with the last word so it never wraps onto a line by itself.
const nameWords = name.split(' ');
const lastWord = nameWords.pop();
const leadingWords = nameWords.join(' ');

// Names fill top-to-bottom, column by column. A grid (rather than CSS columns)
// keeps rows aligned in Safari, which pushes later columns down by a margin.
const rowsFor = (cols: number) => `repeat(${Math.ceil(candidates.length / cols)}, auto)`;
const gridRows = `--rows-2: ${rowsFor(2)}; --rows-3: ${rowsFor(3)}; --rows-4: ${rowsFor(4)}`;
---

<section class:list={["px-6 md:px-16 py-16 bg-w2w-dark bg-cover bg-center relative overflow-hidden", texture]}>
  <div class="absolute inset-0 tex-overlay"></div>

  <div class="max-w-4xl space-y-6 relative z-10">
    
      <div class="mb-8 group">
        <h3 id={id} class="text-3xl md:text-4xl font-black text-w2w-muted uppercase tracking-tight scroll-mt-24">
          {leadingWords} <span class="whitespace-nowrap">{lastWord}<button data-share-id={id} data-share-name={name}
            class="ml-4 pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 focus-visible:opacity-100 transition-opacity text-w2w-muted hover:text-w2w-red text-2xl font-black leading-none cursor-pointer"
            aria-label={`Share link to the ${name} slate`}
          >#</button></span>
        </h3>
    <div class="w-24 h-1.5 bg-gradient-to-r from-w2w-red to-w2w-coral mt-3"></div>
  </div>

  <ul style={gridRows} class="grid grid-flow-col grid-cols-2 grid-rows-(--rows-2) sm:grid-cols-3 sm:grid-rows-(--rows-3) xl:grid-cols-4 xl:grid-rows-(--rows-4) gap-x-8 gap-y-4 list-none p-0 m-0">
    {candidates.map((candidate) => (
      <li class="text-xl font-bold text-w2w-muted flex items-center gap-2">
        <span>{candidate.name}</span>
        {candidate.isDelegate && (
          <svg class="w-4 h-4 text-w2w-red flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-label="FEC Delegate">
            <circle cx="12" cy="12" r="10" />
          </svg>
        )}
      </li>
    ))}
  </ul>

  {hasDelegates && (
    <div class="mt-8 flex items-center gap-3 text-w2w-muted">
      <svg class="w-4 h-4 text-w2w-red flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
      </svg>
      <span class="text-sm font-regular italic">Stop the Demolition of Fulton & Elliott-Chelsea Organizers</span>
    </div>
  )}

  </div>
</section>

<script>
  // Phones get the native share sheet; everything else copies the link.
  const timers = new WeakMap<HTMLElement, number>();

  document.querySelectorAll<HTMLButtonElement>('[data-share-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#${btn.dataset.shareId}`;

      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title: `World to Win | ${btn.dataset.shareName} Slate`, url });
        } catch {
          // User closed the share sheet.
        }
        return;
      }

      await navigator.clipboard.writeText(url);
      btn.textContent = 'Copied!';
      clearTimeout(timers.get(btn));
      timers.set(btn, window.setTimeout(() => (btn.textContent = '#'), 1500));
    });
  });
</script>


