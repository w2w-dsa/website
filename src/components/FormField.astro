---
export interface Props {
  type: 'text' | 'email' | 'textarea' | 'select';
  name: string;
  label: string;
  required?: boolean;
  placeholder?: string;
  options?: string[];
  rows?: number;
}

const { type, name, label, required = false, placeholder = '', options = [], rows = 5 } = Astro.props;
const fieldId = name;
---

<div class="space-y-2">
  <label for={fieldId} class="block text-lg font-black text-w2w-muted">
    {label} {required && <span class="text-w2w-red">*</span>}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={fieldId}
      name={name}
      rows={rows}
      placeholder={placeholder}
      required={required}
      class="w-full bg-transparent border-2 border-w2w-muted/30 rounded-none py-5 px-6 text-w2w-muted placeholder-w2w-muted/40 focus:outline-none focus:border-w2w-red transition-colors resize-none"
    ></textarea>
  ) : type === 'select' ? (
    <select
      id={fieldId}
      name={name}
      required={required}
      class="w-full bg-transparent border-2 border-w2w-muted/30 rounded-none py-5 px-6 text-w2w-muted focus:outline-none focus:border-w2w-red transition-colors appearance-none cursor-pointer"
    >
      <option value="" disabled selected>{placeholder}</option>
      {options.map((option) => (
        <option value={option}>{option}</option>
      ))}
    </select>
  ) : (
    <input
      type={type}
      id={fieldId}
      name={name}
      placeholder={placeholder}
      required={required}
      class="w-full bg-transparent border-2 border-w2w-muted/30 rounded-none py-5 px-6 text-w2w-muted placeholder-w2w-muted/40 focus:outline-none focus:border-w2w-red transition-colors"
    />
  )}
</div>
