---
// src/components/SlateNav.astro
export interface Props {
  branches: { name: string; id: string }[];
}

const { branches } = Astro.props;
---

<nav class="py-8 mb-12">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {branches.map((branch) => (
      <a 
        href={`#${branch.id}`} 
        class="block border-2 border-w2w-muted/30 py-3 px-4 text-center font-black text-w2w-muted hover:border-w2w-red hover:text-w2w-red hover:bg-w2w-red/5 transition-all uppercase tracking-wide text-sm md:text-base"
      >
        {branch.name}
      </a>
    ))}
  </div>
</nav>
