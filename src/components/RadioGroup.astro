---
export interface Props {
  name: string;
  label: string;
  required?: boolean;
  options: string[];
}
const { name, label, required = false, options } = Astro.props;
---
<div class="space-y-4">
  <label class="block text-xl font-black">
    {label} {required && <span class="text-w2w-red">*</span>}
  </label>
  <div class="space-y-3">
    {options.map((option) => (
      <label class="flex items-start gap-3 cursor-pointer group">
        <input 
          type="radio" 
          name={name} 
          value={option} 
          required={required}
          class="peer sr-only" 
        />
        
        <div class="w-6 h-6 border-2 border-w2w-muted mb-[6px] peer-checked:border-w2w-red peer-checked:bg-w2w-red transition-colors flex-shrink-0"></div>
        <span class="text-lg text-w2w-muted group-hover:text-w2w-red transition-colors">
          {option}
        </span>
      </label>
    ))}
  </div>
</div>
