---
export interface Props {
  name: string;
  label: string;
  required?: boolean;
  value?: string;
}

const { name, label, required = false, value = "yes" } = Astro.props;
---

<div class="flex items-start gap-4 pt-2">
  <input 
    type="checkbox" 
    id={name} 
    name={name} 
    value={value}
    class="peer sr-only" 
  />
        <div class="w-6 h-6 border-2 border-w2w-muted mb-[6px] peer-checked:border-w2w-red peer-checked:bg-w2w-red transition-colors flex-shrink-0"></div>

  <label for={name} class="text-lg font-regular text-w2w-muted cursor-pointer leading-relaxed">
    {label} {required && <span class="text-w2w-red">*</span>}
  </label>
</div>
