---
// src/pages/index.astro
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Head from '../components/Head.astro';

const navLinks = [
  { label: 'Platform', href: '/platform' },
  { label: 'Points of Unity', href: '/points-of-unity' },
  { label: 'Interest Form', href: '/interest-form' },
];
---

<!doctype html>
<html lang="en">
  <Head title="World to Win | NYC-DSA Coalition" />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans min-h-screen">
    <main class="min-h-screen flex flex-col md:flex-row pb-28 md:pb-0">
      
      <div class="w-full md:w-1/2 flex flex-col justify-center order-2 md:order-1 relative overflow-hidden bg-tex-2 bg-cover bg-center">
        <div class="absolute inset-0 bg-w2w-dark/80"></div>
        
        <section class="order-3 md:order-1 fixed bottom-0 left-0 w-full py-6 bg-w2w-dark z-50 md:static md:w-auto md:bg-transparent md:py-0 md:pl-14 md:pb-6 flex justify-center md:justify-start">
          <h1 class="sr-only">World to Win</h1>
          <img src="/svgs/text-horizontal1.svg" alt="World to Win" class="h-16 md:h-24 w-auto" />
        </section>

        <section class="order-2 md:order-2 px-6 md:px-16 relative z-10">
          <Nav links={navLinks} />
        </section>
      </div>

      <div class="hidden md:block w-1.5 bg-gradient-to-b from-w2w-red to-w2w-coral flex-shrink-0 my-12 order-3 md:order-2"></div>

      <div class="w-full md:w-1/2 flex flex-col order-1 md:order-3 relative overflow-hidden bg-tex-1 bg-cover bg-center">
        <div class="absolute inset-0 bg-w2w-dark/80"></div>
        
        <section class="flex-grow flex items-center justify-center p-12 relative z-10 min-h-[40vh] md:min-h-0">
          <img src="/svgs/sphere-w-text1.svg" alt="World to Win" class="w-80 md:w-96 lg:w-[36rem]" />
        </section>
      </div>

    </main>
  </body>
</html>
