---
// src/pages/interest-form.astro
import '../styles/global.css';
import Head from '../components/Head.astro';
import P from '../components/P.astro';
import A from '../components/A.astro';
import Footer from '../components/Footer.astro';

---

<!doctype html>
<html lang="en">
  <Head title="World to Win | Interest Form" description="Sign up to join the World to Win coalition for NYC-DSA." />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans min-h-screen flex flex-col">
    
    <main class="flex-grow px-6 md:px-16 py-12 w-full">
      <div class="max-w-3xl mx-auto">
        
          <h1 class="text-3xl md:text-3xl font-black">World to Win Interest Form</h1>

          <P>Fill out our <A href="https://go.w2w.nyc/Ln2Xmc">interest form</A>.</P>

      </div>
    </main>

    <Footer />

  </body>
</html>
