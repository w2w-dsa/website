---
// src/pages/interest-form.astro
import '../styles/global.css';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import FormField from '../components/FormField.astro';

const branches = [
  'Bronx / Upper Manhattan',
  'Lower Manhattan',
  'North Brooklyn',
  'Central Brooklyn',
  'South Brooklyn',
  'Flatbush',
  'Queens',
  'Staten Island',
  'At-Large'
];
---

<!doctype html>
<html lang="en">
  <Head 
    title="World to Win | Interest Form" 
    description="Sign up to join the World to Win coalition for NYC-DSA." 
  />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans min-h-screen flex flex-col">
    
    <main class="flex-grow px-6 md:px-16 py-20 w-full">
      <div class="max-w-2xl mx-auto space-y-12">
        
        <div class="space-y-4">
          <h1 class="text-4xl md:text-5xl font-black text-w2w-muted">
            Join Us
          </h1>
          <div class="w-24 h-1.5 bg-gradient-to-r from-w2w-red to-w2w-coral"></div>
          <p class="text-xl text-w2w-muted font-regular">
            World to Win is a coalition of NYC-DSA members building a chapter ready to connect our long-term vision for democratic socialism to the day-to-day struggle for freedom and dignity. 
          </p>
          <p class="text-xl text-w2w-muted font-regular">
            If you're interested in joining our struggle, please fill out the form below and one of our onboarders will reach out to you.
          </p>
        </div>

        <form 
          name="interest" 
          method="POST" 
          action="/success"
          netlify
          class="space-y-8"
        >
          <input type="hidden" name="form-name" value="interest" />

          <FormField 
            type="text"
            name="name"
            label="Name"
            required
            placeholder="Your name"
          />

          <FormField 
            type="email"
            name="email"
            label="Email"
            required
            placeholder="your@email.com"
          />

          <FormField 
            type="tel"
            name="phone"
            label="Phone Number"
            required
            placeholder="(555) 123-4567"
          />

          <FormField 
            type="text"
            name="pronouns"
            label="Pronouns"
            placeholder="e.g., she/her, they/them, he/him"
          />

          <FormField 
            type="select"
            name="branch"
            label="What branch are you in?"
            required
            placeholder="Select your branch"
            options={branches}
          />

          <FormField 
            type="textarea"
            name="organizing_work"
            label="Please describe your current organizing work within DSA"
            required
            placeholder="What committees, campaigns, or working groups are you involved in?"
            rows={4}
          />

          <FormField 
            type="text"
            name="learned_about"
            label="How did you learn about w2w?"
            placeholder="e.g., Instagram, a friend, a meeting..."
          />

          <FormField 
            type="textarea"
            name="why_interested"
            label="Why are you interested in w2w?"
            placeholder="Share your thoughts..."
            rows={4}
          />

          <FormField 
            type="textarea"
            name="specific_experiences"
            label="Please describe your specific experiences within DSA that inform your interest"
            required
            placeholder="What experiences have shaped your political perspective?"
            rows={4}
          />

          <FormField 
            type="text"
            name="know_members"
            label="Do you know any current members of w2w? If so, please name them"
            placeholder="Optional"
          />

          <div class="flex items-start gap-4 pt-2">
            <input 
              type="checkbox" 
              id="bulletin" 
              name="bulletin" 
              value="yes"
              class="mt-1.5 w-5 h-5 accent-w2w-red border-2 border-w2w-muted/30 rounded-none cursor-pointer" 
            />
            <label for="bulletin" class="text-lg font-regular text-w2w-muted cursor-pointer leading-relaxed">
              Yes, I would like to receive the World To Win member bulletin (short reflections by w2w comrades on our organizing and politics).
            </label>
          </div>

          <div class="pt-6">
            <Button>Submit Interest</Button>
          </div>

        </form>
      </div>
    </main>

    <Footer />
  </body>
</html>
