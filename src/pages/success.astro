---
// src/pages/success.astro
import '../styles/global.css';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<!doctype html>
<html lang="en">
  <Head 
    title="World to Win | Submission Received" 
    description="Thank you for your interest in World to Win." 
  />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans min-h-screen flex flex-col">
    
    <main class="flex-grow px-6 md:px-16 py-20 w-full flex items-center">
      <div class="max-w-2xl mx-auto space-y-8 text-center md:text-left">
        
        <!-- Header -->
        <div class="space-y-4">
          <h1 class="text-4xl md:text-5xl font-black text-w2w-muted">
            Message Received.
          </h1>
          <div class="w-24 h-1.5 bg-gradient-to-r from-w2w-red to-w2w-coral mx-auto md:mx-0"></div>
          <p class="text-xl text-w2w-muted font-regular">
            Thank you for your interest in World to Win. We have received your submission and a comrade will be in touch with you soon.
          </p>
        </div>

        <!-- Return Button -->
        <div class="pt-6">
          <Button href="/">Return Home</Button>
        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>
