---
// src/pages/slate.astro
// The delegate election is over. Old slate links point here; forward them to the
// results, keeping any #branch anchor (a plain meta refresh would drop it).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to Our Delegates</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL('/delegates', Astro.site).href} />
    <script is:inline>location.replace('/delegates' + location.hash);</script>
    <meta http-equiv="refresh" content="0;url=/delegates" />
  </head>
  <body><a href="/delegates">Our Delegates</a></body>
</html>
