<!doctype html>
<html lang="en">
    <Head 
    title="World to Win | 2026 Convention Slate" 
    description="World to Win slate for NYC-DSA Citywide Convention 2026." 
  />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans">
    <main class="space-y-0">
      
      <Header>
        <span slot="title">
            CONVENTION SLATE
        </span>
      </Header>

      <div class="px-6 md:px-16 max-w-7xl mx-auto">
        <SlateNav branches={branches} />
      </div>

      <section class="px-6 md:px-16 py-4 relative overflow-hidden bg-tex-2">
        <div class="absolute inset-0 tex-overlay"></div>
        <div class="max-w-4xl space-y-6 relative z-10">
                <div class="space-y-4 md:pl-14">
                  <P>
                  Under unprecedented circumstances, we make our own history. W2W 
                  delegates believe in building the chapter that this moment 
                  calls for: a machine of revolution rooted in real-world strategy 
                  and member democracy.
                  </P>
                </div>
        </div>
      </section>


      <BranchSlate id="bum" name="Bronx/Upper Manhattan" texture="bg-tex-3" rawList={bum}>
      </BranchSlate>

      <BranchSlate id="cbk" name="Central Brooklyn" texture="bg-tex-1" rawList={cbk}>
      </BranchSlate>

      <BranchSlate id="flatbush" name="Flatbush" texture="bg-tex-2" rawList={flatbush}>
      </BranchSlate>

      <BranchSlate id="lowman" name="Lower Manhattan" texture="bg-tex-4" rawList={lowman}>
      </BranchSlate>

      <BranchSlate id="nbk" name="North Brooklyn" texture="bg-tex-5" rawList={nbk}>
      </BranchSlate>

      <BranchSlate id="queens" name="Queens" texture="bg-tex-2" rawList={queens}>
      </BranchSlate>

      <BranchSlate id="sbk" name="South Brooklyn / SI" texture="bg-tex-1" rawList={sbk}>
      </BranchSlate>

      <BackToTop />

      <Footer />

    </main>
  </body>
</html>

