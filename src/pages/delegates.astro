<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
    <Head
    title="World to Win | 2026 Convention Delegates"
    description="World to Win delegates and alternates elected to the NYC-DSA Citywide Convention 2026."
  />
  <body class="bg-w2w-dark text-w2w-muted antialiased font-sans">
    <main class="space-y-0">

      <Header>
        <span slot="title">
            OUR DELEGATES
        </span>
      </Header>

      <div class="px-6 md:px-16 max-w-7xl mx-auto">
        <SlateNav branches={branches} />
      </div>

      <section class="px-6 md:px-16 py-4 relative overflow-hidden bg-tex-2">
        <div class="absolute inset-0 tex-overlay"></div>
        <div class="max-w-4xl space-y-6 relative z-10">
                <div class="space-y-4 md:pl-14">
                  <P>
                  At 30% of convention delegates, World to Win has secured the
                  largest left delegation to NYC-DSA convention in the chapter’s
                  history.
                  </P>
                  <P>
                  Thank you to everyone who voted for us—we will continue the
                  fight for a stronger NYC-DSA, led by and for members!
                  </P>
                  <P>
                  If you would like to join our organizing, please fill out
                  our <A href="https://go.w2w.nyc/Ln2Xmc">interest form</A>.
                  </P>
                </div>
        </div>
      </section>

      <BranchDelegates id="bum" name="Bronx/Upper Manhattan" texture="bg-tex-3" rawList={bum} alternates={bumAlternates}>
      </BranchDelegates>

      <BranchDelegates id="cbk" name="Central Brooklyn" texture="bg-tex-1" rawList={cbk} alternates={cbkAlternates}>
      </BranchDelegates>

      <BranchDelegates id="flatbush" name="Flatbush" texture="bg-tex-2" rawList={flatbush} alternates={flatbushAlternates}>
      </BranchDelegates>

      <BranchDelegates id="lowman" name="Lower Manhattan" texture="bg-tex-4" rawList={lowman} alternates={lowmanAlternates}>
      </BranchDelegates>

      <BranchDelegates id="nbk" name="North Brooklyn" texture="bg-tex-5" rawList={nbk} alternates={nbkAlternates}>
      </BranchDelegates>

      <BranchDelegates id="queens" name="Queens" texture="bg-tex-2" rawList={queens} alternates={queensAlternates}>
      </BranchDelegates>

      <BranchDelegates id="sbk" name="South Brooklyn / SI" texture="bg-tex-1" rawList={sbk} alternates={sbkAlternates}>
      </BranchDelegates>

      <BackToTop />

      <Footer />

    </main>
  </body>
</html>
